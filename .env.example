# ─────────────────────────────────────────────────────────────
# SDR IA — configuração 12-factor. Copie para `.env` e preencha.
# NENHUM valor real de segredo deve ser commitado. `.env` está no .gitignore.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=sdr
POSTGRES_PORT=5432

# Roles de isolamento (criadas pelo init do container)
APP_DB_USER=sdr_app
APP_DB_PASSWORD=troque_isto_app
MIGRATOR_DB_USER=sdr_migrator
MIGRATOR_DB_PASSWORD=troque_isto_migrator

# URL de runtime (app_user, SEM bypass de RLS) e de migrations (migrator, DDL)
DATABASE_URL=postgres://sdr_app:troque_isto_app@localhost:5432/sdr
MIGRATION_DATABASE_URL=postgres://sdr_migrator:troque_isto_migrator@localhost:5432/sdr

# ── Redis ─────────────────────────────────────────────────────
# DEV: sem senha (localhost). PROD: o docker-compose.prod.yml liga --requirepass
# ${REDIS_PASSWORD} e monta a REDIS_URL com a senha (redis://:senha@redis:6379).
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Só usado em produção (docker-compose.prod.yml). Gere com: openssl rand -base64 32
REDIS_PASSWORD=

# ── Portas das apps ──────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000

# ── CORS ─────────────────────────────────────────────────────
# Origem(ns) do painel que podem chamar a API (lista separada por vírgula).
# EM PRODUÇÃO: use a origem HTTPS real (ex.: https://sdr.seudominio.com.br) — a
# config REJEITA o boot se for localhost/vazio ou `*` (CORS usa credentials).
WEB_ORIGIN=http://localhost:3000

# ── Autenticação do painel ───────────────────────────────────
# Segredos distintos para access e refresh. Gere com:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=GERE_COM_openssl_rand_base64_48
JWT_REFRESH_SECRET=GERE_OUTRO_COM_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false

# ── Envelope encryption (tenant_secrets) ─────────────────────
# KEK mestra de 32 bytes em base64. Gere com:
#   openssl rand -base64 32
# `SECRETS_KEK_ACTIVE_VERSION` aponta a versão usada para escrever.
# Para rotação, adicione SECRETS_KEK_V2 e mude a versão ativa.
SECRETS_KEK_V1=GERE_32_BYTES_COM_openssl_rand_base64_32
SECRETS_KEK_ACTIVE_VERSION=1

# ── Observabilidade (opcional / pluggable) ───────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sdr-api
SENTRY_DSN=

# ── WhatsApp Cloud API (segredos da PLATAFORMA, não do tenant) ─
# appSecret valida a assinatura X-Hub-Signature-256; verifyToken responde o
# challenge GET do webhook. O token de ENVIO é por tenant (TenantSecretsStore).
WHATSAPP_APP_SECRET=defina_o_app_secret_da_meta
WHATSAPP_VERIFY_TOKEN=defina_um_verify_token_qualquer
WHATSAPP_GRAPH_API_BASE=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v21.0
# Embedded Signup (M3) — IDs/segredos da plataforma
WHATSAPP_APP_ID=defina_o_app_id
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=defina_o_config_id
WHATSAPP_SYSTEM_USER_TOKEN=opcional_conforme_estrategia_de_token

# ── LLM (M4) — chave de PLATAFORMA (fallback) + cadeia default ─
# Por tenant: a chave fica cifrada no TenantSecretsStore (kind llm_api_key).
LLM_ANTHROPIC_API_KEY=sk-ant-...
LLM_DEFAULT_MODELS=claude-haiku-4-5,claude-sonnet-4-6,claude-opus-4-8

# ── Transcrição / áudio (M12) — STT openai-compatible ─────────
# baseURL = Whisper self-hosted (ex.: http://whisper:9000/v1) OU provedor por token.
# Por tenant: chave cifrada no TenantSecretsStore (kind transcription_api_key).
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_LANGUAGE=pt
TRANSCRIPTION_MAX_DURATION_SECONDS=300
TRANSCRIPTION_MAX_BYTES=16777216

# ── Canal não-oficial / Baileys (M13) — OPCIONAL, default OFF ─
# ⚠️ Viola os Termos do WhatsApp; o número pode ser banido. Default do produto é
# a Cloud API oficial. Liga por tenant, de olhos abertos. Em prod, instale
# @whiskeysockets/baileys no container do session-worker (APP_ROLE=session-worker).
BAILEYS_ENABLED=false
SESSION_WORKER_INDEX=0
SESSION_WORKER_TOTAL=1
BAILEYS_RECONNECT_BASE_MS=2000
BAILEYS_RECONNECT_MAX_MS=60000
BAILEYS_QR_TTL_SECONDS=90

# ── M9 — staff de plataforma (curadoria/kits) ─────────────────
PLATFORM_ADMIN_TOKEN=troque-por-um-token-forte

# ── M11 — operação / VPS ──────────────────────────────────────
# Papel do processo: api | worker | scheduler | all (dev=all). Em prod, um por container.
APP_ROLE=all
# Alertas internos ao operador (Telegram/Slack/webhook). Vazio = só log.
ALERTS_WEBHOOK_URL=
ALERTS_DISK_THRESHOLD=85
ALERTS_OUTBOX_FAILED_THRESHOLD=20
# Deploy (docker-compose.prod.yml + Caddy TLS automático)
DOMAIN=sdr.seudominio.com.br
ACME_EMAIL=ops@seudominio.com.br
# Backup cifrado p/ bucket externo (deploy/backup.sh)
BACKUP_GPG_RECIPIENT=
BACKUP_S3_URI=

# ── FORK IMOBILIÁRIO — envs próprias (revisão Codex final) ───────────────────
# Vertical imobiliária (defaults sensatos; ver apps/api/src/imobiliario/imob.config.ts)
# IMOB_ACCEPT_SLA_MINUTES=5        # corretor aceita em N min ou redistribui
# IMOB_MAX_ATTEMPTS=3              # rodadas de distribuição por lead
# IMOB_FOLLOWUP_HOURS=24           # cobrança de status após N horas parado
# IMOB_MAX_FOLLOWUPS=3             # cobranças sem resposta até alertar gestor
# IMOB_PROJECT_NAME="Parque das Flores"  # nome do empreendimento nas fichas

# Leitura de integração (Central da Parceria) — FAIL-CLOSED: vazio desliga
# IMOB_PLATFORM_READ_TENANTS=uuid-do-tenant-1,uuid-do-tenant-2

# Entrada de leads de campanha — FAIL-CLOSED: sem token/allowlist, desligado
# LEAD_INTAKE_TOKEN=token-forte-de-producao
# LEAD_INTAKE_TENANTS=uuid-do-tenant-1,uuid-do-tenant-2

# Webhook direto Meta Lead Ads (opcional; sem app Meta use /integrations/leads)
# META_LEADGEN_VERIFY_TOKEN=token-do-handshake
# META_APP_SECRET=app-secret-do-app-meta
# META_LEADGEN_PAGES="pageId:tenantId; pageId2:tenantId2"
# META_PAGE_ACCESS_TOKEN=token-de-pagina-p-buscar-lead-no-graph
